# Required: NRE primitives call OpenRouter under the hood.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1

# Optional: pin which model the NRE primitives use. Defaults inside NRE config.
# Examples: anthropic/claude-sonnet-4, anthropic/claude-3.5-sonnet, openai/gpt-4o
# NRE_LLM_MODEL=anthropic/claude-sonnet-4

# Optional: User-Agent for scraping. Default is a desktop Chrome string.
# HOUSE_SOLD_USER_AGENT="Mozilla/5.0 ..."
